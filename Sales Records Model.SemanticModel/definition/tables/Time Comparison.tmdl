table 'Time Comparison'

	calculationGroup
		precedence: 10

		calculationItem Current = SELECTEDMEASURE()

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Previous Year' = IF(ISSELECTEDMEASURE([Profit Margin %], [Revenue Budget Attainment %], [Profit Budget Attainment %], [Revenue Variance %], [Profit Variance %]), SELECTEDMEASURE(), CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('date'[full_date])))

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem YoY = IF(ISSELECTEDMEASURE([Profit Margin %], [Revenue Budget Attainment %], [Profit Budget Attainment %], [Revenue Variance %], [Profit Variance %]), SELECTEDMEASURE(), SELECTEDMEASURE() - CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('date'[full_date])))

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'YoY %' = IF(ISSELECTEDMEASURE([Profit Margin %], [Revenue Budget Attainment %], [Profit Budget Attainment %], [Revenue Variance %], [Profit Variance %]), SELECTEDMEASURE(), DIVIDE(SELECTEDMEASURE() - CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('date'[full_date])), CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('date'[full_date]))))

			formatStringDefinition = IF(ISSELECTEDMEASURE([Profit Margin %], [Revenue Budget Attainment %], [Profit Budget Attainment %], [Revenue Variance %], [Profit Variance %]), SELECTEDMEASUREFORMATSTRING(), "0.00%;-0.00%;0.00%")

		calculationItem YTD = IF(ISSELECTEDMEASURE([Profit Margin %], [Revenue Budget Attainment %], [Profit Budget Attainment %], [Revenue Variance %], [Profit Variance %]), SELECTEDMEASURE(), CALCULATE(SELECTEDMEASURE(), DATESYTD('date'[full_date])))

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

	column 'Time Comparison'
		dataType: string
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

	column Ordinal
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: Ordinal

